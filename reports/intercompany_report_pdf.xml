<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_intercompany_report_pdf" model="ir.actions.report">
        <field name="name">Reporte de Suministro Inter-empresa</field>
        <field name="model">intercompany.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">inter_company_automation.ic_report_pdf</field>
        <field name="report_file">inter_company_automation.ic_report_pdf</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="ic_report_pdf">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="docs[0] if docs else None"/>
                <div class="page">
                    <style>
                        body {
                            font-family: 'DejaVu Sans', Arial, sans-serif;
                            font-size: 9px;
                            color: #2c2c2c;
                            background: #ffffff;
                        }

                        /* ── CABECERA ── */
                        .lh-wrap {
                            width: 100%;
                            border-collapse: collapse;
                            border-bottom: 2px solid #c9a96e;
                            margin-bottom: 4px;
                        }
                        .lh-wrap td { vertical-align: bottom; padding-bottom: 10px; }
                        .brand {
                            font-size: 20px; font-weight: 700;
                            letter-spacing: 5px; text-transform: uppercase; color: #1a1a1a;
                        }
                        .brand-gold { color: #c9a96e; }
                        .brand-sub {
                            display: block; font-size: 6.5px; letter-spacing: 6px;
                            color: #c9a96e; margin-top: 2px; text-transform: uppercase;
                        }
                        .doc-title { text-align: right; }
                        .doc-title h1 {
                            font-size: 13px; font-weight: 700; text-transform: uppercase;
                            letter-spacing: 2px; color: #1a1a1a; margin: 0 0 2px 0;
                        }
                        .doc-title .doc-sub { font-size: 7px; color: #aaa; letter-spacing: 1px; }

                        /* ── PARTES ── */
                        .parties-wrap { width: 100%; border-collapse: collapse; margin: 14px 0; }
                        .party-box {
                            width: 48%; border: 1px solid #ede8df;
                            border-top: 3px solid #c9a96e; padding: 9px 13px; vertical-align: top;
                        }
                        .party-box .pb-role {
                            font-size: 6px; text-transform: uppercase; letter-spacing: 1.5px;
                            color: #c9a96e; font-weight: 700; display: block; margin-bottom: 3px;
                        }
                        .party-box .pb-name { font-size: 11px; font-weight: 700; color: #1a1a1a; }
                        .party-spacer { width: 4%; }

                        /* ── META ── */
                        .meta-bar {
                            width: 100%; border-collapse: collapse;
                            background: #faf8f5; border: 1px solid #ede8df;
                            border-left: 3px solid #c9a96e; margin-bottom: 20px;
                        }
                        .meta-bar td {
                            padding: 8px 14px; font-size: 8px;
                            vertical-align: top; border-right: 1px solid #ede8df;
                        }
                        .meta-bar td:last-child { border-right: none; }
                        .meta-bar .ml {
                            display: block; font-size: 6px; text-transform: uppercase;
                            letter-spacing: 1px; color: #c9a96e; font-weight: 700; margin-bottom: 2px;
                        }
                        .meta-bar .mv { font-size: 9.5px; font-weight: 700; color: #1a1a1a; }

                        /* ── SECTION HEADER ── */
                        .sh { width: 100%; border-collapse: collapse; border-bottom: 1px solid #c9a96e; margin-bottom: 0; }
                        .sh td { padding: 5px 0 3px 0; vertical-align: middle; }
                        .sh .st { font-size: 8.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #1a1a1a; }
                        .sh .st-dot { color: #c9a96e; margin-right: 5px; }
                        .sh .sc { text-align: right; font-size: 7px; color: #c9a96e; font-weight: 600; }

                        /* ── TABLA RESUMEN ── */
                        table.rt {
                            width: 100%; border-collapse: collapse;
                            font-size: 8px; margin-bottom: 18px;
                        }
                        table.rt thead th {
                            padding: 5px 8px; text-align: left; font-weight: 700;
                            font-size: 6.5px; text-transform: uppercase; letter-spacing: 0.5px;
                            color: #888; border-bottom: 1px solid #ede8df;
                            background: #faf8f5; white-space: nowrap;
                        }
                        table.rt thead th.tr { text-align: right; }
                        table.rt tbody tr { border-bottom: 1px solid #f0ece6; }
                        table.rt tbody tr.alt { background: #faf8f5; }
                        table.rt tbody td { padding: 5px 8px; vertical-align: middle; color: #2c2c2c; }
                        table.rt tbody td.tr { text-align: right; }
                        table.rt tbody td.mono { font-family: monospace; font-size: 7px; color: #888; }
                        table.rt tbody td.bold { font-weight: 700; }
                        table.rt tbody td.gold { color: #c9a96e; font-weight: 700; }
                        table.rt tbody td.muted { color: #aaa; font-size: 7.5px; }
                        table.rt tfoot tr { background: #1a1a1a; }
                        table.rt tfoot td { padding: 6px 8px; font-size: 8.5px; font-weight: 700; color: #fff; }
                        table.rt tfoot td.tr { text-align: right; }
                        table.rt tfoot td.gold { color: #c9a96e; }

                        /* ── TABLA DETALLE OCs ── */
                        table.dt {
                            width: 100%; border-collapse: collapse;
                            font-size: 8px; margin-bottom: 18px;
                        }
                        table.dt thead th {
                            padding: 5px 8px; text-align: left; font-weight: 700;
                            font-size: 6.5px; text-transform: uppercase; letter-spacing: 0.5px;
                            color: #888; border-bottom: 1px solid #ede8df;
                            background: #faf8f5; white-space: nowrap;
                        }
                        table.dt thead th.tr { text-align: right; }

                        /* Fila de folio (cabecera de grupo) */
                        table.dt tr.folio-row td {
                            background: #f5f0e8;
                            border-top: 1px solid #c9a96e;
                            border-bottom: 1px solid #e8dfc8;
                            padding: 5px 8px;
                            font-weight: 700;
                            font-size: 8px;
                            color: #1a1a1a;
                        }
                        table.dt tr.folio-row td.gold { color: #c9a96e; }
                        table.dt tr.folio-row td.tr { text-align: right; }

                        /* Filas de lineas bajo el folio */
                        table.dt tr.line-row td {
                            padding: 4px 8px 4px 20px;
                            border-bottom: 1px solid #f5f0e8;
                            color: #444;
                            font-size: 7.5px;
                        }
                        table.dt tr.line-row td.tr { text-align: right; }
                        table.dt tr.line-row td.mono { font-family: monospace; font-size: 7px; color: #888; }
                        table.dt tr.line-row.alt td { background: #fdfcfa; }

                        /* Fila de subtotal del folio */
                        table.dt tr.subtotal-row td {
                            padding: 4px 8px;
                            border-bottom: 2px solid #e8dfc8;
                            font-size: 7.5px;
                            color: #888;
                            font-style: italic;
                        }
                        table.dt tr.subtotal-row td.tr { text-align: right; }
                        table.dt tr.subtotal-row td.gold { color: #c9a96e; font-weight: 700; font-style: normal; }

                        table.dt tfoot tr { background: #1a1a1a; }
                        table.dt tfoot td { padding: 6px 8px; font-size: 8.5px; font-weight: 700; color: #fff; }
                        table.dt tfoot td.tr { text-align: right; }
                        table.dt tfoot td.gold { color: #c9a96e; }

                        /* ── NOTA LEGAL ── */
                        .legal-note {
                            border: 1px solid #ede8df; border-left: 3px solid #c9a96e;
                            background: #faf8f5; padding: 10px 14px;
                            font-size: 7.5px; color: #555; margin-top: 18px; line-height: 1.7;
                        }
                        .legal-note strong { color: #1a1a1a; }

                        /* ── BADGE ── */
                        .badge {
                            display: inline-block; padding: 2px 5px; border-radius: 2px;
                            font-size: 6px; font-weight: 700; text-transform: uppercase;
                        }
                        .badge-purchase, .badge-done { background:#edf7ed; color:#2e7d32; border:1px solid #c8e6c9; }
                        .badge-draft                 { background:#fef9e7; color:#b7860d; border:1px solid #f9e9a0; }
                        .badge-cancel                { background:#fdecea; color:#c62828; border:1px solid #f5c6cb; }
                    </style>

                    <!-- ══ CABECERA ══ -->
                    <table class="lh-wrap">
                        <tr>
                            <td style="width:50%">
                            </td>
                            <td class="doc-title">
                                <h1>Concentrado de Suministro</h1>
                                <div class="doc-sub">Anexo al Contrato de Suministro Inter-empresa</div>
                            </td>
                        </tr>
                    </table>

                    <!-- ══ PARTES ══ -->
                    <table class="parties-wrap">
                        <tr>
                            <td class="party-box">
                                <span class="pb-role">Compradora</span>
                                <span class="pb-name" t-esc="data.get('company_name','')"/>
                            </td>
                            <td class="party-spacer"/>
                            <td class="party-box">
                                <span class="pb-role">Proveedora / Suministradora</span>
                                <span class="pb-name">Loomber Global</span>
                            </td>
                        </tr>
                    </table>

                    <!-- ══ META ══ -->
                    <table class="meta-bar">
                        <tr>
                            <td>
                                <span class="ml">Periodo</span>
                                <span class="mv">
                                    <t t-esc="data.get('date_start','')"/>&#160;&#8212;&#160;<t t-esc="data.get('date_end','')"/>
                                </span>
                            </td>
                            <td>
                                <span class="ml">Total de OC incluidas</span>
                                <span class="mv" t-esc="po_count"/>
                            </td>
                            <td>
                                <span class="ml">Importe Total</span>
                                <span class="mv" style="color:#c9a96e">
                                    <t t-esc="currency_symbol"/>&#160;<t t-esc="grand_total"/>
                                </span>
                            </td>
                        </tr>
                    </table>

                    <!-- ══ RESUMEN POR PRODUCTO ══ -->
                    <table class="sh">
                        <tr>
                            <td><span class="st"><span class="st-dot">&#9632;</span>Resumen por Producto</span></td>
                            <td class="sc"><t t-esc="len(summary_lines)"/> productos</td>
                        </tr>
                    </table>
                    <table class="rt">
                        <thead>
                            <tr>
                                <th style="width:14%">SKU</th>
                                <th>Producto</th>
                                <th class="tr" style="width:13%">Cantidad Total</th>
                                <th style="width:6%">UM</th>
                                <th class="tr" style="width:16%">Importe Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary_lines" t-as="line">
                                <tr t-att-class="'alt' if line_index % 2 == 1 else ''">
                                    <td class="mono" t-esc="line['sku']"/>
                                    <td class="bold" t-esc="line['product']"/>
                                    <td class="tr" t-esc="line['qty']"/>
                                    <td class="muted" t-esc="line['uom']"/>
                                    <td class="tr gold">
                                        <t t-esc="currency_symbol"/>&#160;<t t-esc="line['total']"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="tr">IMPORTE TOTAL</td>
                                <td class="tr gold">
                                    <t t-esc="currency_symbol"/>&#160;<t t-esc="grand_total"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ══ DETALLE POR OC ══ -->
                    <table class="sh">
                        <tr>
                            <td><span class="st"><span class="st-dot">&#9632;</span>Detalle de Ordenes de Compra</span></td>
                            <td class="sc"><t t-esc="po_count"/> ordenes</td>
                        </tr>
                    </table>
                    <table class="dt">
                        <thead>
                            <tr>
                                <th style="width:14%">No. Orden / SKU</th>
                                <th>Producto</th>
                                <th style="width:10%">Fecha</th>
                                <th style="width:6%">UM</th>
                                <th class="tr" style="width:10%">Cantidad</th>
                                <th class="tr" style="width:11%">P. Unit.</th>
                                <th class="tr" style="width:13%">Importe</th>
                                <th style="width:7%">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="po_lines" t-as="po">
                                <!-- Fila del folio -->
                                <tr class="folio-row">
                                    <td colspan="2" class="bold">
                                        <t t-esc="po['name']"/>
                                        &#160;&#160;
                                        <span style="font-weight:400; font-size:7px; color:#888">
                                            Ref: <t t-esc="po['ref']"/>
                                        </span>
                                    </td>
                                    <td t-esc="po['date']"/>
                                    <td colspan="3"/>
                                    <td class="tr gold"><t t-esc="po['currency']"/>&#160;<t t-esc="po['total']"/></td>
                                    <td>
                                        <span t-attf-class="badge badge-#{po['state'].lower()}"
                                              t-esc="po['state']"/>
                                    </td>
                                </tr>
                                <!-- Filas de líneas -->
                                <t t-foreach="po['lines']" t-as="line">
                                    <tr t-att-class="'line-row alt' if line_index % 2 == 1 else 'line-row'">
                                        <td class="mono" t-esc="line['sku']"/>
                                        <td t-esc="line['product']"/>
                                        <td/>
                                        <td class="muted" t-esc="line['uom']"/>
                                        <td class="tr" t-esc="line['qty']"/>
                                        <td class="tr"><t t-esc="po['currency']"/>&#160;<t t-esc="line['price_unit']"/></td>
                                        <td class="tr"><t t-esc="po['currency']"/>&#160;<t t-esc="line['subtotal']"/></td>
                                        <td/>
                                    </tr>
                                </t>
                                <!-- Subtotal del folio -->
                                <tr class="subtotal-row">
                                    <td colspan="6" class="tr">Subtotal / Impuestos</td>
                                    <td class="tr gold">
                                        <t t-esc="po['currency']"/>&#160;<t t-esc="po['subtotal']"/>
                                        &#160;/&#160;
                                        <t t-esc="po['currency']"/>&#160;<t t-esc="po['taxes']"/>
                                    </td>
                                    <td/>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="6" class="tr">TOTAL GENERAL</td>
                                <td class="tr gold" t-esc="grand_total"/>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>

                    <!-- ══ NOTA LEGAL ══ -->
                    <div class="legal-note">
                        <strong>Nota:</strong> El presente concentrado forma parte integral del Contrato de Suministro celebrado entre
                        <strong t-esc="data.get('company_name','')"/> y <strong>Loomber Global</strong>.
                        Las ordenes de compra relacionadas en este documento amparan las operaciones de suministro
                        correspondientes al periodo del <strong t-esc="data.get('date_start','')"/>
                        al <strong t-esc="data.get('date_end','')"/>,
                        por un importe total de
                        <strong><t t-esc="currency_symbol"/>&#160;<t t-esc="grand_total"/></strong>.
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>