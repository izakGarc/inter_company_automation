<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="intercompany_report_wizard_form" model="ir.ui.view">
        <field name="name">intercompany.report.wizard.form</field>
        <field name="model">intercompany.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Suministro Inter-empresa">
                <sheet>
                    <div class="oe_title">
                        <h2>Reporte de Órdenes de Compra</h2>
                        <p class="text-muted">
                            Concentrado de órdenes de compra emitidas a Loomber Global.
                            Este reporte se utiliza como anexo al contrato de suministro.
                        </p>
                    </div>
                    <group>
                        <group string="Periodo">
                            <field name="date_start" string="Fecha Inicio"/>
                            <field name="date_end"   string="Fecha Fin"/>
                        </group>
                        <group string="Empresa">
                            <field name="company_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generar PDF"
                            type="object"
                            name="action_print_pdf"
                            class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button string="Cancelar"
                            special="cancel"
                            class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_intercompany_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Suministro Inter-empresa</field>
        <field name="res_model">intercompany.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_intercompany_report_purchase"
        name="Reporte de Suministro Inter-empresa"
        action="action_intercompany_report_wizard"
        parent="purchase.purchase_report_main"
        sequence="10"/>
</odoo>